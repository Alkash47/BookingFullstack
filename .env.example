# ======================================================
# ШАБЛОН .env — скопируй в .env и заполни своими значениями
# ======================================================

# JWT секретный ключ — сгенерируй случайный: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Пароль администратора (логин: admin)
ADMIN_PASSWORD=your-admin-password-here

# URL базы данных
# Локально: DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Railway даст: DATABASE_URL=postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./dev.db
